# ==============================================================================
# RevenueOS — Canonical Environment Configuration Template
# ==============================================================================
# DO NOT insert real credentials into this file.
# Copy this file to .env for local development and set actual values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend: Django Core & Security
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000
DJANGO_SECRET_KEY=change-me-to-a-secure-random-string-at-least-50-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Database: MongoDB Atlas
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=revenueos

# ------------------------------------------------------------------------------
# Payments: Razorpay Test Mode
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# ------------------------------------------------------------------------------
# AI: Google Gemini API (Official GenAI SDK)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Security: Cloudflare Turnstile
# ------------------------------------------------------------------------------
TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# Frontend: Public Configuration (Exposed to Browser)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/v1/app/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx
